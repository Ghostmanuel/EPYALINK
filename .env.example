# Copia este ficheiro para ".env" e preenche os valores antes de correr localmente.
# No Render, estas variáveis são definidas em Settings → Environment (ver README.md).

# Ligação à base de dados PostgreSQL (o Render fornece isto automaticamente
# se ligares um serviço "PostgreSQL" ao Web Service — ver render.yaml).
DATABASE_URL=postgresql://user:password@host:5432/agrolink

# Segredo usado para assinar as sessões (JWT). Usa uma string aleatória longa em produção.
JWT_SECRET=muda_isto_para_uma_string_aleatoria_longa

# Porta em que o servidor arranca (o Render define isto automaticamente).
PORT=3000

# ---- KambaSMS: recuperação de password por SMS ----
# Chave obtida em https://www.kambasms.ao/dashboard/keys
# Sem esta chave definida, o AgroLink cai automaticamente num modo de
# desenvolvimento: gera o código localmente e mostra-o na resposta da API
# (nunca em produção) e no log do servidor, para poderes testar sem custos.
KAMBASMS_API_KEY=
# Confirma este endereço no dashboard da KambaSMS antes de ires para produção.
KAMBASMS_BASE_URL=https://api.kambasms.ao

# ---- WhatsApp (opcional): recuperação de password por WhatsApp ----
# A KambaSMS não oferece WhatsApp — isto usa a Meta Cloud API (Business).
# Sem estas variáveis definidas, o canal "WhatsApp" usa o mesmo modo local
# de desenvolvimento do SMS (código mostrado na resposta/consola).
WHATSAPP_TOKEN=
WHATSAPP_PHONE_ID=
WHATSAPP_OTP_TEMPLATE=otp_code

NODE_ENV=production
